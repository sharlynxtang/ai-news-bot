# --- LLM / Summarizer -------------------------------------------------------
# 支持任何 OpenAI 兼容 API（官方或第三方兼容服务）。
OPENAI_API_KEY=your-openai-compatible-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Feishu / Lark push -----------------------------------------------------
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your-webhook-token

# --- Collection tuning (all optional, sensible defaults in config.py) -------
# HTTP request timeout in seconds
HTTP_TIMEOUT=10
# Number of retry attempts per request
HTTP_RETRIES=3
# Lookback window in hours for HN / arXiv
LOOKBACK_HOURS=24
# Hacker News minimum points threshold
HN_MIN_POINTS=50
# Max items to keep per source (0 = unlimited)
MAX_ITEMS_PER_SOURCE=30
